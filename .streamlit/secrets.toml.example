# Copy this file to .streamlit/secrets.toml and paste your key.
# secrets.toml is listed in .gitignore and must never be committed.
OPENAI_API_KEY = "your-key-here"

# Local models instead of OpenAI: delete the key line above and use these.
# LLM_PROVIDER = "ollama"
# OLLAMA_CHAT_MODEL = "llama3.1:8b"       # or "llama3.2:3b" on machines under 16 GB RAM
# OLLAMA_EMBED_MODEL = "nomic-embed-text"
# RELEVANCE_THRESHOLD = "0.45"            # optional override of the gate in rag/config.py
